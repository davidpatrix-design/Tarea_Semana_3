@model Cliente
@{
    ViewData["Title"] = "Nuevo cliente";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Registrar nuevo cliente</h4>
            </div>
            <div class="card-body">
                <p class="text-muted">Todos los campos son obligatorios.</p>

                @using (Html.BeginForm("Nuevo", "Cliente", FormMethod.Post))
                {
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.Nombres, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Nombres, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Nombres, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.Apellidos, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Apellidos, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Apellidos, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.Cedula, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Cedula, new { @class = "form-control", maxlength = "10", inputmode = "numeric" })
                            @Html.ValidationMessageFor(m => m.Cedula, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.Celular, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Celular, new { @class = "form-control", maxlength = "10", inputmode = "numeric", placeholder = "09XXXXXXXX" })
                            @Html.ValidationMessageFor(m => m.Celular, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-12 mb-3">
                            @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.FechaNacimiento, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.FechaNacimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(m => m.FechaNacimiento, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6 mb-3">
                            <fieldset>
                                <legend class="form-label fs-6">Sexo</legend>
                                <div class="form-check form-check-inline">
                                    @Html.RadioButtonFor(m => m.Sexo, "Masculino", new { @class = "form-check-input", id = "sexoMasculino" })
                                    <label class="form-check-label" for="sexoMasculino">Masculino</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    @Html.RadioButtonFor(m => m.Sexo, "Femenino", new { @class = "form-check-input", id = "sexoFemenino" })
                                    <label class="form-check-label" for="sexoFemenino">Femenino</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    @Html.RadioButtonFor(m => m.Sexo, "Otro", new { @class = "form-check-input", id = "sexoOtro" })
                                    <label class="form-check-label" for="sexoOtro">Otro</label>
                                </div>
                            </fieldset>
                            @Html.ValidationMessageFor(m => m.Sexo, "", new { @class = "text-danger small d-block" })
                        </div>

                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.Ciudad, new { @class = "form-label" })
                            @Html.DropDownListFor(m => m.Ciudad, new SelectList((List<string>)ViewBag.Ciudades), "-- Seleccione --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(m => m.Ciudad, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.CupoCredito, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                @Html.TextBoxFor(m => m.CupoCredito, new { @class = "form-control", type = "number", min = "0", max = "5000" })
                            </div>
                            @Html.ValidationMessageFor(m => m.CupoCredito, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-12 mb-3">
                            @Html.LabelFor(m => m.Direccion, new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.Direccion, 2, 40, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Direccion, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <a href="/Cliente" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
